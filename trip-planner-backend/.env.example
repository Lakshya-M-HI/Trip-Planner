# ============================================================
# AI Trip Planner — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/trip-planner

# ── Authentication (JWT) ─────────────────────────────────────
ACCESS_TOKEN_SECRET=your_access_token_secret_here_min_32_chars
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_min_32_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ── Google Maps API ──────────────────────────────────────────
# Used for: Geocoding, Directions, Distance Matrix, Places, Autocomplete
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Amadeus API ──────────────────────────────────────────────
# Used for: Flight search, Hotel search
# Get keys at: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# ── Rome2rio API ─────────────────────────────────────────────
# Used for: Multi-modal transport (trains, buses, ferries)
# Get key at: https://www.rome2rio.com/documentation/
ROME2RIO_API_KEY=your_rome2rio_api_key_here

# ── Foursquare API ───────────────────────────────────────────
# Used for: Tourist attractions, landmarks, points of interest
# Get key at: https://location.foursquare.com/developer/
FOURSQUARE_API_KEY=your_foursquare_api_key_here

# ── Google Gemini AI ─────────────────────────────────────────
# Used for: AI-powered itinerary generation & budget optimization
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenWeatherMap API ───────────────────────────────────────
# Used for: Weather forecast at destination
# Get key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── Exchange Rate API ────────────────────────────────────────
# Used for: Multi-currency conversion
# Get key at: https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here

# ── Frontend URL ─────────────────────────────────────────────
# Used for: CORS configuration
FRONTEND_URL=http://localhost:3000
